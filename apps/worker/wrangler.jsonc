{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-os",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Access protects only the custom domain; workers.dev and preview URLs would bypass it.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/v1/*"],
  },
  "vars": {
    "REQUIRE_ACCESS": "true",
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "personal-os-assertions",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-os",
      "database_id": "replace-with-d1-database-id",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "personal-os-evidence",
    },
  ],
}
